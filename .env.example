OPENAI_API_KEY=your_openai_api_key

# llm_utils.py / semantic-library/embeddings.py — OPTIONAL, routes every
# chat + embedding call in this repo to Azure OpenAI instead of plain
# OpenAI once ENDPOINT + API_KEY + CHAT_DEPLOYMENT are all set (plain
# OpenAI above is used otherwise). EMBEDDING_DEPLOYMENT is only required
# if you also want embeddings on Azure (separate from chat).
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_KEY=your-azure-openai-key
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=your-chat-deployment-name
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=your-embedding-deployment-name

INPUT_FOLDER=./InputResume_Folder
OUTPUT_FOLDER=./OutputResume_Folder
CSV_FOLDER=./Resume_Parsed_CSVs
GMAIL_WATCHER_USER=your-gmail-address@gmail.com
GMAIL_WATCHER_APP_PASSWORD=your-gmail-app-password

# context-lake/ (Azure Cosmos DB + Blob Storage) — only needed once those
# resources are provisioned; see context-lake/README.md and
# docs/azure-provisioning/phase2-cosmos-storage-keyvault.md
COSMOS_ENDPOINT=https://your-cosmos-account.documents.azure.com:443/
COSMOS_KEY=your-cosmos-primary-key
COSMOS_DATABASE=cdpi

# Resource group to show real resource/cost data for on the Azure Readiness
# page's "Cost & Usage" tab (az_cli.py). Requires `az login` locally — this
# app never provisions or deletes based on this value, only reads.
AZURE_RESOURCE_GROUP=your-resource-group-name

# Log Analytics workspace (the "customerId" GUID, not the resource name) the
# Azure Observability Report page queries real telemetry back from, via
# azure_monitor_query.py. Find it with:
#   az monitor log-analytics workspace show --resource-group <rg> --workspace-name <name> --query customerId
# Requires `az login` locally. Read-only — this app never writes to Log
# Analytics directly (telemetry export is Application Insights' own job).
AZURE_LOG_ANALYTICS_WORKSPACE_ID=your-log-analytics-workspace-customer-id
BLOB_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net

# auth.py — real login/session signing for the Admin Panel's user/role
# system (see IAM_RBAC.md). A long random value, not a password —
# generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=generate-a-long-random-value-do-not-use-this-placeholder

# secrets_loader.py — only needed once Key Vault is provisioned; once set,
# OPENAI_API_KEY/GMAIL_WATCHER_*/COSMOS_*/BLOB_*/etc. are all read from Key
# Vault first, falling back to the plain values above if a lookup fails
AZURE_KEY_VAULT_URL=https://your-keyvault-name.vault.azure.net/

# observability.py — only needed once Application Insights is provisioned;
# logs/llm_observability.jsonl is always written regardless, this just
# also sends the same data to Azure
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...;IngestionEndpoint=...

# document_intelligence_client.py — only needed once Azure AI Document
# Intelligence is provisioned; see
# docs/azure-provisioning/phase5-document-intelligence-whatsapp.md
DOCUMENT_INTELLIGENCE_ENDPOINT=https://your-resource-name.cognitiveservices.azure.com/
DOCUMENT_INTELLIGENCE_KEY=your-document-intelligence-key

# whatsapp_client.py — only needed once a Meta WhatsApp Business Cloud API
# app is set up (NOT an Azure resource); see
# docs/azure-provisioning/phase5-document-intelligence-whatsapp.md
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-whatsapp-permanent-access-token

# voicebot/azure_speech_utils.py — only needed once Azure AI Speech is
# provisioned; replaces the old ElevenLabs (TTS) + unofficial Google Web
# Speech (STT) vendors. See docs/azure-provisioning/phase6-speech.md
AZURE_SPEECH_KEY=your-speech-resource-key
AZURE_SPEECH_REGION=your-speech-resource-region
